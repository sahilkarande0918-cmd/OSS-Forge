# Copy to .env (never commit .env). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Hosted Gemma 4 model: gemma-4-26b-a4b-it (default) or gemma-4-31b-it
OSS_FORGE_MODEL=gemma-4-26b-a4b-it

# Hard budgets enforced before every API call
OSS_FORGE_MAX_CONTEXT_TOKENS=12000
OSS_FORGE_MAX_API_CALLS=30
OSS_FORGE_MAX_PATCH_ATTEMPTS=3

# true = analyse/plan only; no repository code is executed and no patch is applied
OSS_FORGE_DRY_RUN=true

# Optional
# OSS_FORGE_THINKING=high             # high (default) | minimal
# OSS_FORGE_JSON_MODE=template        # template (default) | schema (native response_json_schema)
# OSS_FORGE_TIMEOUT_SECONDS=120       # per API request
# OSS_FORGE_SANDBOX=auto              # auto | docker | host
# OSS_FORGE_HOME=.oss-forge           # runs, caches, repo memory
# OSS_FORGE_PRICE_INPUT_PER_M=0       # USD per 1M input tokens (for cost estimates)
# OSS_FORGE_PRICE_OUTPUT_PER_M=0      # USD per 1M output tokens
